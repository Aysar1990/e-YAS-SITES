# TSSR Monitor API Server - Environment Variables
# Copy this file to .env and fill in the values

# ===========================================
# SUPABASE CONFIGURATION (Required)
# ===========================================

# Supabase Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Key (for client-side realtime)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (for server-side operations)
# WARNING: Keep this secret! Never expose in client-side code
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ===========================================
# JWT CONFIGURATION
# ===========================================

# Secret key for signing JWT tokens
# Generate a strong random string for production
JWT_SECRET=your-super-secret-key-change-this-in-production

# Token expiry time (e.g., 24h, 7d, 30d)
JWT_EXPIRY=24h

# ===========================================
# SERVER CONFIGURATION
# ===========================================

# Port number (Render sets this automatically)
PORT=3001

# Node environment
NODE_ENV=production

# ===========================================
# SECURITY
# ===========================================

# Bcrypt rounds for password hashing
BCRYPT_ROUNDS=10

# ===========================================
# OPTIONAL
# ===========================================

# Enable debug logging
DEBUG=false

# Allowed CORS origins (comma-separated)
# Leave empty to allow all origins
CORS_ORIGINS=
