# YAS TSSR Monitor - Environment Variables

# API Configuration
VITE_API_URL=http://localhost:3000/api
VITE_API_TIMEOUT=30000

# App Configuration
VITE_APP_NAME=YAS TSSR Monitor
VITE_APP_VERSION=1.0.0

# Authentication (Client-side)
VITE_JWT_SECRET=your-secret-key-here
VITE_TOKEN_EXPIRY=86400

# Server-side Authentication (IMPORTANT: Change in production!)
# Used by Electron main process and API Server
JWT_SECRET=generate-a-strong-random-secret-here-minimum-32-chars
JWT_EXPIRY=24h
BCRYPT_ROUNDS=10

# Feature Flags
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_OFFLINE_MODE=true

# Debug
VITE_DEBUG_MODE=false

# ============================================
# Database Configuration (NEW - Day 1)
# ============================================

# Database Type: 'sqlite' or 'supabase'
DATABASE_TYPE=sqlite

# ============================================
# Supabase Configuration (if using Supabase)
# ============================================

# Your Supabase project URL
# Example: https://xxxxxxxxxxxxx.supabase.co
SUPABASE_URL=your_supabase_url_here

# Supabase Anonymous/Public API Key
# This key is safe to use in client applications
# Find it in: Supabase Dashboard > Settings > API > Project API keys > anon/public
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service/Role Key (SERVER-SIDE ONLY!)
# ⚠️ WARNING: This key has full database access!
# Only use in server-side code (Electron main process)
# NEVER expose this key in client-side code or version control!
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# ============================================
# SQLite Configuration (if using SQLite)
# ============================================

# Path to SQLite database file
SQLITE_PATH=./data/tssr.db

# Use sql.js (in-memory) instead of better-sqlite3
# Set to 'true' for environments without native modules support
USE_SQL_JS=false

# ============================================
# Server Ports
# ============================================

# REST API Server Port
API_PORT=3001

# WebSocket Server Port
WS_PORT=3002

# Auto-save interval in milliseconds (SQLite only)
AUTO_SAVE_INTERVAL=30000
