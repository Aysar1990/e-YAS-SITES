/**
 * Spreadsheet View - Excel-like data editor with FULL CONTROL
 * UPDATED: Fullscreen without MainLayout, Solid BG, Column Manager, Density Control
 * PHASE 1: Added Stats Widget, Freeze Columns, Recent Changes Highlight
 * PHASE 2: Added Smart Search, Saved Views/Presets
 * PHASE 3: Added Export Dialog, Cell History & Audit Trail
 * PHASE 4: Added Conditional Formatting, Smart Suggestions
 * PHASE 5: Added Collaboration Features (Activity Feed, Presence, Comments)
 * PHASE 6: Added Data Management (Bulk Edit, Import, Advanced Filter, Validation)
 */

import React, { useState, useEffect, useCallback, useMemo, useRef } from 'react'
import { AgGridReact } from 'ag-grid-react'
import 'ag-grid-community/styles/ag-grid.css'
import 'ag-grid-community/styles/ag-theme-alpine.css'
import MainLayout from '../../../components/Layout/MainLayout'
import { useSitesData } from '../../../components/Sites'
import { ALL_COLUMNS } from './columns'
import StatsWidget from './components/StatsWidget'
import SmartSearch from './components/SmartSearch'
import ViewsManager from './components/ViewsManager'
import ExportDialog from './components/ExportDialog'
import CellHistoryPanel from './components/CellHistoryPanel'
import FormattingRules from './components/FormattingRules'
import SuggestionsPanel from './components/SuggestionsPanel'
// Phase 5: Collaboration Components
import ActivityFeed, { logActivity } from './components/ActivityFeed'
import OnlineUsers from './components/UserPresence'
import CommentsPanel from './components/Comments'
import { presenceService } from './services/firebase/presence'
// Phase 6: Data Management Components
import BulkEditModal from './components/BulkEdit'
import ImportModal from './components/Import'
import FilterBuilder from './components/AdvancedFilter'
import { getValidationEngine, getValidationCellStyle } from './utils/validation'
import { useRecentChanges } from './hooks/useRecentChanges'
import { useSavedViews } from './hooks/useSavedViews'
import { useCellHistory } from './hooks/useCellHistory'
import { useSmartSuggestions } from './hooks/useSmartSuggestions'
import { loadRulesFromStorage, applyFormattingRules } from './utils/formattingRules'
import './SpreadsheetView.css'

const SpreadsheetView = () => {
  const gridRef = useRef(null)
  const { sites, loading, updateFirebaseSite, useFirebase } = useSitesData()
  const [rowData, setRowData] = useState([])
  const [quickFilter, setQuickFilter] = useState('')
  const [isFullscreen, setIsFullscreen] = useState(false)

  // View Controls
  const [density, setDensity] = useState('comfortable') // comfortable, compact, dense
  const [fontSize, setFontSize] = useState(13) // 11-16
  const [showColumnManager, setShowColumnManager] = useState(false)
  const [hiddenColumns, setHiddenColumns] = useState([])

  // Phase 1: New States
  const [showStats, setShowStats] = useState(false) // Stats widget visibility
  const [pinnedColumns, setPinnedColumns] = useState(['site_id']) // Frozen columns

  // Phase 1: Recent Changes Hook
  const { markChanged, isRecentlyChanged } = useRecentChanges(10)

  // Phase 2: New States
  const [showViewsManager, setShowViewsManager] = useState(false) // Views panel visibility
  const [filteredData, setFilteredData] = useState(null) // Search-filtered data
  const [searchQuery, setSearchQuery] = useState(null) // Current search query

  // Phase 2: Saved Views Hook
  const {
    views,
    currentView,
    createView,
    deleteView,
    applyView,
    clearView
  } = useSavedViews()

  // Phase 3: New States
  const [showExportDialog, setShowExportDialog] = useState(false) // Export dialog visibility
  const [showHistoryPanel, setShowHistoryPanel] = useState(false) // Cell history panel visibility
  const [selectedCell, setSelectedCell] = useState(null) // Selected cell for history {siteId, field, fieldLabel}
  const [selectedRows, setSelectedRows] = useState([]) // Selected rows for export

  // Phase 3: Cell History Hook
  const {
    addHistoryEntry,
    getCellHistory,
    revertChange
  } = useCellHistory()

  // Phase 4: Formatting Rules State
  const [formattingRules, setFormattingRules] = useState(() => loadRulesFromStorage())
  const [showFormattingPanel, setShowFormattingPanel] = useState(false)

  // Phase 4: Smart Suggestions
  const [showSuggestionsPanel, setShowSuggestionsPanel] = useState(false)
  const {
    suggestions,
    dismissSuggestion,
    clearDismissed,
    hasNew: hasNewSuggestions,
    dismissedCount
  } = useSmartSuggestions(rowData)

  // Phase 5: Collaboration States
  const [showActivityFeed, setShowActivityFeed] = useState(false)
  const [showOnlineUsers, setShowOnlineUsers] = useState(false)
  const [showComments, setShowComments] = useState(false)
  const [selectedSiteForComments, setSelectedSiteForComments] = useState(null)
  const [onlineUsers, setOnlineUsers] = useState([])

  // Current user (in production, this would come from auth context)
  const [currentUser] = useState(() => {
    // Try to get user from localStorage or generate a temporary one
    const stored = localStorage.getItem('tssr_current_user')
    if (stored) {
      try {
        return JSON.parse(stored)
      } catch {
        // Ignore parse errors
      }
    }
    // Generate temporary user for demo
    const tempUser = {
      id: `user_${Date.now()}`,
      name: `مستخدم ${Math.floor(Math.random() * 1000)}`
    }
    localStorage.setItem('tssr_current_user', JSON.stringify(tempUser))
    return tempUser
  })

  // Phase 6: Data Management States
  const [showBulkEdit, setShowBulkEdit] = useState(false)
  const [showImportModal, setShowImportModal] = useState(false)
  const [showAdvancedFilter, setShowAdvancedFilter] = useState(false)
  const [validationErrors, setValidationErrors] = useState({})
  const [activeFilter, setActiveFilter] = useState(null)

  // Phase 6: Validation Engine
  const validationEngine = useMemo(() => getValidationEngine(), [])
  
  // Column Definitions - ALL 68 columns (with freeze, highlight, and formatting support)
  const columnDefs = useMemo(() =>
    ALL_COLUMNS.map(col => ({
      ...col,
      hide: hiddenColumns.includes(col.field),
      pinned: pinnedColumns.includes(col.field) ? 'left' : null,
      filter: col.type === 'number' ? 'agNumberColumnFilter' : 'agTextColumnFilter',
      cellClass: (params) => {
        const classes = []
        // Readonly cells
        if (col.editable === false) classes.push('cell-readonly')
        // Recent changes highlighting
        if (params.data && isRecentlyChanged(params.data.site_id, col.field, 5)) {
          classes.push('cell-changed-recent') // < 5 min - pulse animation
        } else if (params.data && isRecentlyChanged(params.data.site_id, col.field, 60)) {
          classes.push('cell-changed-hour') // < 1 hour - light highlight
        }
        return classes.join(' ')
      },
      // Phase 4: Apply conditional formatting rules via cellStyle
      cellStyle: (params) => {
        const value = params.value
        const field = params.colDef.field
        return applyFormattingRules(value, field, formattingRules)
      },
      valueParser: col.type === 'number'
        ? (params => parseFloat(params.newValue) || params.oldValue)
        : undefined,
      cellClassRules: col.field.includes('status') ? {
        'cell-approved': params => params.value === 'Approved' || params.value === 'approved',
        'cell-pending': params => params.value?.toLowerCase().includes('pending') || params.value?.toLowerCase().includes('under'),
        'cell-rejected': params => params.value === 'Rejected' || params.value === 'rejected'
      } : undefined
    }))
  , [hiddenColumns, pinnedColumns, isRecentlyChanged, formattingRules])

  // Default column properties - PHASE 6: Added cell borders and center alignment
  const defaultColDef = useMemo(() => ({
    sortable: true,
    resizable: true,
    filter: 'agTextColumnFilter',
    floatingFilter: true,
    enableCellChangeFlash: true,
    minWidth: 80,
    // Phase 6 Bonus: Center alignment
    cellStyle: {
      display: 'flex',
      alignItems: 'center',
      justifyContent: 'center',
      textAlign: 'center'
    },
    // Phase 6 Bonus: Excel-style filter dropdowns
    filterParams: {
      buttons: ['reset', 'apply'],
      closeOnApply: true
    }
  }), [])

  // Density settings
  const densitySettings = useMemo(() => ({
    comfortable: { rowHeight: 40, headerHeight: 50, fontSize: 14 },
    compact: { rowHeight: 32, headerHeight: 42, fontSize: 13 },
    dense: { rowHeight: 26, headerHeight: 36, fontSize: 12 }
  }), [])

  const currentDensity = densitySettings[density]

  // Load sites data
  useEffect(() => {
    if (sites && sites.length > 0) {
      setRowData(sites)
    }
  }, [sites])

  // ESC key handler
  useEffect(() => {
    const handleKeyDown = (e) => {
      if (e.key === 'Escape' && isFullscreen) {
        setIsFullscreen(false)
      }
    }
    window.addEventListener('keydown', handleKeyDown)
    return () => window.removeEventListener('keydown', handleKeyDown)
  }, [isFullscreen])

  // Phase 5: Initialize presence service and listen to online users
  useEffect(() => {
    if (!currentUser?.id) return

    let unsubscribe = null

    const initPresence = async () => {
      try {
        await presenceService.initialize(currentUser.id, currentUser.name)
        unsubscribe = presenceService.listen((users) => {
          setOnlineUsers(users)
        })
      } catch (error) {
        console.error('[SpreadsheetView] Presence init error:', error)
      }
    }

    initPresence()

    return () => {
      if (unsubscribe) unsubscribe()
      presenceService.cleanup()
    }
  }, [currentUser?.id, currentUser?.name])

  // Cell value changed
  const onCellValueChanged = useCallback(async (params) => {
    const { data, colDef } = params
    const field = colDef.field
    const oldValue = params.oldValue
    const newValue = params.newValue

    // Skip if no actual change
    if (oldValue === newValue) return

    // Phase 3: Record change in history BEFORE Firebase update
    addHistoryEntry(data.site_id, field, oldValue, newValue)

    // Phase 1: Mark cell as recently changed
    markChanged(data.site_id, field)

    // Phase 5: Log activity
    logActivity({
      type: field.includes('status') ? 'status_change' : 'edit',
      siteId: data.site_id,
      siteName: data.final_site_name || data.site_id,
      userId: currentUser?.id,
      userName: currentUser?.name,
      details: {
        field,
        fieldLabel: colDef.headerName,
        oldValue,
        newValue
      }
    })

    if (useFirebase) {
      try {
        const updates = { [field]: newValue }
        await updateFirebaseSite(data.site_id, updates)
      } catch (error) {
        console.error('Update failed:', error)
        params.node.setDataValue(field, oldValue)
      }
    }
  }, [useFirebase, updateFirebaseSite, markChanged, addHistoryEntry, currentUser])

  // Export to Excel
  const onExportExcel = useCallback(() => {
    gridRef.current.api.exportDataAsExcel({
      fileName: `TSSR_Data_${new Date().toISOString().split('T')[0]}.xlsx`
    })
  }, [])

  // Auto-fit columns
  const autoFitColumns = useCallback(() => {
    if (gridRef.current?.api) {
      const allColumnIds = gridRef.current.api.getColumns()
        .filter(col => !col.colDef.hide)
        .map(col => col.getColId())
      gridRef.current.api.autoSizeColumns(allColumnIds)
    }
  }, [])

  // Size columns to fit
  const sizeToFit = useCallback(() => {
    if (gridRef.current?.api) {
      gridRef.current.api.sizeColumnsToFit()
    }
  }, [])

  // Toggle fullscreen
  const toggleFullscreen = useCallback(() => {
    setIsFullscreen(prev => !prev)
  }, [])

  // Toggle column visibility
  const toggleColumn = useCallback((field) => {
    setHiddenColumns(prev => 
      prev.includes(field) 
        ? prev.filter(f => f !== field)
        : [...prev, field]
    )
  }, [])

  // Show all columns
  const showAllColumns = useCallback(() => {
    setHiddenColumns([])
  }, [])

  // Hide all except essential
  const showEssentialOnly = useCallback(() => {
    const essential = ['site_id', 'final_site_name', 'governorate', 'tssr_overall_status',
                       'ti_status', 'rf_plan_status', 'rf_optim_status', 'civil_status']
    setHiddenColumns(ALL_COLUMNS.map(c => c.field).filter(f => !essential.includes(f)))
  }, [])

  // Phase 1: Toggle freeze column
  const toggleFreeze = useCallback((field) => {
    setPinnedColumns(prev =>
      prev.includes(field)
        ? prev.filter(f => f !== field)
        : [...prev, field]
    )
  }, [])

  // Phase 1: Handle stat click for filtering
  const handleStatClick = useCallback((type, value) => {
    let filterValue = ''

    switch (type) {
      case 'all':
        filterValue = ''
        break
      case 'approved':
        filterValue = 'Approved'
        break
      case 'pending':
        filterValue = 'pending'
        break
      case 'rejected':
        filterValue = 'Rejected'
        break
      case 'gov':
        filterValue = value || ''
        break
      default:
        filterValue = ''
    }

    setQuickFilter(filterValue)
  }, [])

  // Phase 2: Handle search results from SmartSearch
  const handleSearchResults = useCallback((results, query) => {
    setFilteredData(results)
    setSearchQuery(query)
    // Clear ag-grid quick filter when using smart search
    setQuickFilter('')
  }, [])

  // Phase 2: Get current grid configuration for saving views
  const getCurrentConfig = useCallback(() => {
    const visibleColumns = ALL_COLUMNS
      .filter(col => !hiddenColumns.includes(col.field))
      .map(col => col.field)

    return {
      visibleColumns,
      density,
      filters: null, // Could capture ag-grid filters here
      sort: null, // Could capture ag-grid sort here
      pinnedColumns: [...pinnedColumns]
    }
  }, [hiddenColumns, density, pinnedColumns])

  // Phase 2: Handle view application
  const handleApplyView = useCallback((viewId) => {
    const config = applyView(viewId)
    if (!config) return

    // Apply visible columns
    if (config.visibleColumns && config.visibleColumns.length > 0) {
      const allFields = ALL_COLUMNS.map(c => c.field)
      const hidden = allFields.filter(f => !config.visibleColumns.includes(f))
      setHiddenColumns(hidden)
    }

    // Apply density
    if (config.density) {
      setDensity(config.density)
    }

    // Apply pinned columns
    if (config.pinnedColumns) {
      setPinnedColumns(config.pinnedColumns)
    }

    // Apply filters if present
    if (config.filters && gridRef.current?.api) {
      // For simple filter, use quick filter
      const filterValues = Object.values(config.filters).filter(Boolean)
      if (filterValues.length > 0) {
        setQuickFilter(filterValues[0])
      }
    }

    // Close views manager after applying
    setShowViewsManager(false)
  }, [applyView])

  // Phase 2: Handle view creation
  const handleCreateView = useCallback((name, config, icon) => {
    const currentConfig = getCurrentConfig()
    createView(name, currentConfig, icon)
  }, [createView, getCurrentConfig])

  // Phase 3: Handle cell click for history panel (Ctrl+Click)
  const onCellClicked = useCallback((params) => {
    if (params.event.ctrlKey || params.event.metaKey) {
      const { data, colDef } = params
      if (data && colDef) {
        setSelectedCell({
          siteId: data.site_id,
          field: colDef.field,
          fieldLabel: colDef.headerName
        })
        setShowHistoryPanel(true)
      }
    }
  }, [])

  // Phase 3: Handle row selection change
  const onSelectionChanged = useCallback(() => {
    if (gridRef.current?.api) {
      const selected = gridRef.current.api.getSelectedRows()
      setSelectedRows(selected)
    }
  }, [])

  // Phase 3: Handle revert from history panel
  const handleRevert = useCallback((entryId) => {
    const revertedEntry = revertChange(entryId)
    if (revertedEntry && gridRef.current?.api) {
      // Find and update the row in the grid
      gridRef.current.api.forEachNode(node => {
        if (node.data?.site_id === revertedEntry.siteId) {
          node.setDataValue(revertedEntry.field, revertedEntry.oldValue)
        }
      })
    }
  }, [revertChange])

  // Phase 4: Handle suggestion action clicks - apply filter to grid
  const handleSuggestionAction = useCallback((filter, suggestion) => {
    if (!filter) return

    // Close suggestions panel after action
    setShowSuggestionsPanel(false)

    switch (filter.type) {
      case 'smart':
        // Use the smart search query
        setSearchQuery(filter.query)
        // Trigger search via SmartSearch component would need ref,
        // instead use quickFilter as fallback
        if (filter.query) {
          setQuickFilter(filter.query.split(':').pop() || '')
        }
        break

      case 'field':
        // Filter by specific field value
        if (filter.field && filter.value) {
          if (filter.negate) {
            // Filter to show rows where field != value
            const filtered = rowData.filter(row => row[filter.field] !== filter.value)
            setFilteredData(filtered)
            setSearchQuery(`${filter.field}:!${filter.value}`)
          } else {
            // Filter to show rows where field == value
            setQuickFilter(filter.value)
          }
        }
        break

      case 'combined':
        // Multiple filters
        if (filter.filters && filter.filters.length > 0) {
          let filtered = [...rowData]
          filter.filters.forEach(f => {
            if (f.negate) {
              filtered = filtered.filter(row => row[f.field] !== f.value)
            } else {
              filtered = filtered.filter(row =>
                String(row[f.field] || '').toLowerCase().includes(String(f.value).toLowerCase())
              )
            }
          })
          setFilteredData(filtered)
          setSearchQuery('Combined filter applied')
        }
        break

      case 'custom':
        // Custom predicate filters
        if (filter.predicate === 'quick_wins') {
          // Find sites with 3+ departments approved but not overall approved
          const deptFields = ['ti_status', 'rf_plan_status', 'rf_optim_status', 'civil_status']
          const quickWins = rowData.filter(site => {
            if (site.tssr_overall_status === 'Approved') return false
            const approvedDepts = deptFields.filter(field =>
              site[field]?.toLowerCase() === 'approved'
            ).length
            return approvedDepts >= 3
          })
          setFilteredData(quickWins)
          setSearchQuery('Quick wins: 3+ depts approved')
        }
        break

      default:
        // Simple string filter
        if (typeof filter === 'string') {
          setQuickFilter(filter)
        }
    }
  }, [rowData])

  // Phase 5: Open comments for selected row
  const handleOpenComments = useCallback((siteId, siteName) => {
    setSelectedSiteForComments({ id: siteId, name: siteName })
    setShowComments(true)
    // Update presence to show which site user is viewing
    presenceService.setCurrentSite(siteId, siteName)
  }, [])

  // Phase 5: Handle mention notification
  const handleMention = useCallback((userId, siteId, siteName, text) => {
    // Log mention activity
    logActivity({
      type: 'mention',
      siteId,
      siteName,
      userId: currentUser?.id,
      userName: currentUser?.name,
      details: {
        mentionedUserId: userId,
        text: text.substring(0, 100)
      }
    })
    console.log(`[SpreadsheetView] Mentioned user ${userId} in ${siteId}`)
  }, [currentUser])

  // Phase 5: Handle row double-click to open comments
  const onRowDoubleClicked = useCallback((params) => {
    const { data } = params
    if (data?.site_id) {
      handleOpenComments(data.site_id, data.final_site_name || data.site_id)
    }
  }, [handleOpenComments])

  // Phase 6: Handle bulk edit apply
  const handleBulkEditApply = useCallback(async (field, value, rows) => {
    if (!rows || rows.length === 0) return

    // Update each row
    for (const row of rows) {
      if (gridRef.current?.api) {
        gridRef.current.api.forEachNode(node => {
          if (node.data?.site_id === row.site_id) {
            node.setDataValue(field, value)
          }
        })
      }

      // Update Firebase if enabled
      if (useFirebase) {
        try {
          await updateFirebaseSite(row.site_id, { [field]: value })
        } catch (error) {
          console.error(`[BulkEdit] Failed to update ${row.site_id}:`, error)
        }
      }
    }

    // Log activity
    logActivity({
      type: 'edit',
      siteId: 'bulk',
      siteName: `${rows.length} sites`,
      userId: currentUser?.id,
      userName: currentUser?.name,
      details: {
        field,
        newValue: value,
        rowCount: rows.length,
        isBulkEdit: true
      }
    })

    console.log(`[BulkEdit] Updated ${rows.length} rows`)
  }, [useFirebase, updateFirebaseSite, currentUser])

  // Phase 6: Handle import data
  const handleImportData = useCallback(async (importedRows) => {
    if (!importedRows || importedRows.length === 0) return { imported: 0 }

    let imported = 0
    let errors = 0

    for (const row of importedRows) {
      try {
        if (useFirebase && row.site_id) {
          await updateFirebaseSite(row.site_id, row)
          imported++
        } else {
          // For local mode, just add to rowData
          imported++
        }
      } catch (error) {
        console.error(`[Import] Failed to import row:`, error)
        errors++
      }
    }

    // Refresh data
    if (imported > 0) {
      // Data will be refreshed via Firebase listener
      logActivity({
        type: 'import',
        siteId: 'import',
        siteName: 'Excel Import',
        userId: currentUser?.id,
        userName: currentUser?.name,
        details: {
          count: imported,
          format: 'Excel'
        }
      })
    }

    return { imported, errors }
  }, [useFirebase, updateFirebaseSite, currentUser])

  // Phase 6: Handle advanced filter apply
  const handleAdvancedFilterApply = useCallback((filteredData, filterConfig) => {
    if (!filteredData) {
      // Clear filter
      setFilteredData(null)
      setSearchQuery(null)
      setActiveFilter(null)
      return
    }

    setFilteredData(filteredData)
    setSearchQuery(filterConfig?.name || 'Advanced Filter')
    setActiveFilter(filterConfig)
    setShowAdvancedFilter(false)
  }, [])

  // Phase 6: Clear advanced filter
  const handleClearAdvancedFilter = useCallback(() => {
    setFilteredData(null)
    setSearchQuery(null)
    setActiveFilter(null)
  }, [])

  if (loading) {
    return (
      <MainLayout>
        <div className="spreadsheet-loading">
          <div className="spinner"></div>
          <p>Loading spreadsheet data...</p>
        </div>
      </MainLayout>
    )
  }

  // Fullscreen content (NO MainLayout)
  const spreadsheetContent = (
    <div className={`spreadsheet-container ${isFullscreen ? 'fullscreen' : ''}`} 
         style={{ fontSize: `${fontSize}px` }}>
      {/* Toolbar */}
      <div className="spreadsheet-toolbar">
        <div className="toolbar-left">
          <h1>Spreadsheet View</h1>
          <span className="row-count">
            {searchQuery
              ? `${filteredData?.length || 0} / ${rowData.length} sites`
              : `${rowData.length} sites`}
          </span>
          <span className="visible-cols">
            {ALL_COLUMNS.length - hiddenColumns.length}/{ALL_COLUMNS.length} columns
          </span>
          {currentView && (
            <span className="current-view-badge" title={`Active view: ${currentView.name}`}>
              {currentView.icon} {currentView.name}
            </span>
          )}
        </div>
        
        <div className="toolbar-center">
          {/* Phase 2: Smart Search replaces basic quick filter */}
          <SmartSearch
            data={rowData}
            onSearchResults={handleSearchResults}
            columns={null}
          />
        </div>
        
        <div className="toolbar-right">
          {/* Density Control */}
          <div className="density-control">
            <button 
              onClick={() => setDensity('comfortable')} 
              className={`btn-density ${density === 'comfortable' ? 'active' : ''}`}
              title="Comfortable"
            >
              ⊞
            </button>
            <button 
              onClick={() => setDensity('compact')} 
              className={`btn-density ${density === 'compact' ? 'active' : ''}`}
              title="Compact"
            >
              ⊟
            </button>
            <button 
              onClick={() => setDensity('dense')} 
              className={`btn-density ${density === 'dense' ? 'active' : ''}`}
              title="Dense"
            >
              ≡
            </button>
          </div>

          {/* Font Size */}
          <div className="font-control">
            <button onClick={() => setFontSize(s => Math.max(11, s - 1))} className="btn-icon">
              A-
            </button>
            <span className="font-size">{fontSize}px</span>
            <button onClick={() => setFontSize(s => Math.min(16, s + 1))} className="btn-icon">
              A+
            </button>
          </div>
          
          <button onClick={autoFitColumns} className="btn-icon" title="Auto-fit Columns">
            📏 Auto-fit
          </button>
          <button onClick={sizeToFit} className="btn-icon" title="Fit to Screen">
            ⇔ Fit Screen
          </button>
          <button
            onClick={() => setShowStats(!showStats)}
            className={`btn-icon ${showStats ? 'active' : ''}`}
            title="Quick Stats"
          >
            Stats
          </button>
          <button
            onClick={() => setShowViewsManager(!showViewsManager)}
            className={`btn-icon ${showViewsManager ? 'active' : ''} ${currentView ? 'has-view' : ''}`}
            title={currentView ? `View: ${currentView.name}` : 'Saved Views'}
          >
            {currentView ? `${currentView.icon} View` : 'Views'}
          </button>
          <button
            onClick={() => setShowColumnManager(!showColumnManager)}
            className={`btn-icon ${showColumnManager ? 'active' : ''}`}
            title="Column Manager"
          >
            ☰ Columns
          </button>
          <button onClick={toggleFullscreen} className="btn-icon" title={isFullscreen ? "Exit (ESC)" : "Fullscreen"}>
            {isFullscreen ? '⛶ Exit' : '⛶ Full'}
          </button>
          {/* Phase 4: Formatting Rules Button */}
          <button
            onClick={() => setShowFormattingPanel(!showFormattingPanel)}
            className={`btn-icon ${showFormattingPanel ? 'active' : ''}`}
            title="Conditional Formatting"
          >
            🎨 Format
          </button>
          {/* Phase 4: Smart Suggestions Button */}
          <button
            onClick={() => setShowSuggestionsPanel(!showSuggestionsPanel)}
            className={`btn-icon btn-suggestions ${showSuggestionsPanel ? 'active' : ''} ${hasNewSuggestions ? 'has-suggestions' : ''}`}
            title={`Smart Suggestions ${hasNewSuggestions ? `(${suggestions.length} active)` : ''}`}
          >
            🤖 AI
            {hasNewSuggestions && (
              <span className="suggestion-badge">{suggestions.length}</span>
            )}
          </button>
          {/* Phase 5: Collaboration Buttons */}
          <button
            onClick={() => setShowActivityFeed(!showActivityFeed)}
            className={`btn-icon ${showActivityFeed ? 'active' : ''}`}
            title="سجل الأنشطة"
          >
            📋 الأنشطة
          </button>
          <button
            onClick={() => setShowComments(!showComments)}
            className={`btn-icon ${showComments ? 'active' : ''}`}
            title="التعليقات"
          >
            💬 تعليقات
          </button>
          <OnlineUsers
            currentUser={currentUser}
            compact={true}
            onUserClick={(user) => console.log('User clicked:', user)}
          />
          {/* Phase 6: Data Management Buttons */}
          <button
            onClick={() => setShowBulkEdit(true)}
            className={`btn-icon ${selectedRows.length > 0 ? 'has-selection' : ''}`}
            title={`تعديل جماعي${selectedRows.length > 0 ? ` (${selectedRows.length})` : ''}`}
            disabled={selectedRows.length === 0}
          >
            📝 جماعي
            {selectedRows.length > 0 && (
              <span className="selection-badge">{selectedRows.length}</span>
            )}
          </button>
          <button
            onClick={() => setShowImportModal(true)}
            className="btn-icon"
            title="استيراد من Excel"
          >
            📤 استيراد
          </button>
          <button
            onClick={() => setShowAdvancedFilter(true)}
            className={`btn-icon ${activeFilter ? 'active has-filter' : ''}`}
            title="فلتر متقدم"
          >
            🔍 فلتر
            {activeFilter && (
              <button
                className="clear-filter-btn"
                onClick={(e) => {
                  e.stopPropagation()
                  handleClearAdvancedFilter()
                }}
                title="مسح الفلتر"
              >
                ×
              </button>
            )}
          </button>
          <button onClick={() => setShowExportDialog(true)} className="btn-primary">
            📥 Export
          </button>
        </div>
      </div>

      {/* Phase 1: Stats Widget */}
      {showStats && (
        <StatsWidget
          data={filteredData || rowData}
          onStatClick={handleStatClick}
          onClose={() => setShowStats(false)}
        />
      )}

      {/* Phase 2: Views Manager */}
      {showViewsManager && (
        <ViewsManager
          views={views}
          currentView={currentView}
          onApplyView={handleApplyView}
          onCreateView={handleCreateView}
          onDeleteView={deleteView}
          onClose={() => setShowViewsManager(false)}
          currentConfig={getCurrentConfig()}
        />
      )}

      {/* Phase 3: Export Dialog */}
      {showExportDialog && (
        <ExportDialog
          data={searchQuery ? filteredData : rowData}
          columns={columnDefs}
          selectedRows={selectedRows}
          onClose={() => setShowExportDialog(false)}
        />
      )}

      {/* Phase 3: Cell History Panel */}
      {showHistoryPanel && selectedCell && (
        <CellHistoryPanel
          siteId={selectedCell.siteId}
          field={selectedCell.field}
          fieldLabel={selectedCell.fieldLabel}
          getCellHistory={getCellHistory}
          onRevert={handleRevert}
          onClose={() => {
            setShowHistoryPanel(false)
            setSelectedCell(null)
          }}
        />
      )}

      {/* Phase 4: Formatting Rules Panel */}
      {showFormattingPanel && (
        <FormattingRules
          rules={formattingRules}
          onUpdateRules={setFormattingRules}
          onClose={() => setShowFormattingPanel(false)}
          columns={ALL_COLUMNS}
        />
      )}

      {/* Phase 4: Smart Suggestions Panel */}
      {showSuggestionsPanel && (
        <SuggestionsPanel
          suggestions={suggestions}
          onDismiss={dismissSuggestion}
          onAction={handleSuggestionAction}
          onClose={() => setShowSuggestionsPanel(false)}
          dismissedCount={dismissedCount}
          onClearDismissed={clearDismissed}
        />
      )}

      {/* Phase 5: Activity Feed Panel */}
      {showActivityFeed && (
        <ActivityFeed
          currentUser={currentUser}
          onClose={() => setShowActivityFeed(false)}
        />
      )}

      {/* Phase 5: Comments Panel */}
      {showComments && selectedSiteForComments && (
        <CommentsPanel
          siteId={selectedSiteForComments.id}
          siteName={selectedSiteForComments.name}
          currentUser={currentUser}
          onlineUsers={onlineUsers}
          onClose={() => {
            setShowComments(false)
            setSelectedSiteForComments(null)
            presenceService.setCurrentSite(null)
          }}
          onMention={handleMention}
        />
      )}

      {/* Phase 5: Comments Panel (no site selected - prompt to select) */}
      {showComments && !selectedSiteForComments && (
        <div className="comments-prompt">
          <div className="prompt-content">
            <span className="prompt-icon">💬</span>
            <p>انقر مرتين على صف لفتح التعليقات</p>
            <button
              className="btn-sm"
              onClick={() => setShowComments(false)}
            >
              إغلاق
            </button>
          </div>
        </div>
      )}

      {/* Phase 6: Bulk Edit Modal */}
      {showBulkEdit && (
        <BulkEditModal
          selectedRows={selectedRows}
          onApply={handleBulkEditApply}
          onClose={() => setShowBulkEdit(false)}
        />
      )}

      {/* Phase 6: Import Modal */}
      {showImportModal && (
        <ImportModal
          columns={ALL_COLUMNS}
          onImport={handleImportData}
          onClose={() => setShowImportModal(false)}
        />
      )}

      {/* Phase 6: Advanced Filter Builder */}
      {showAdvancedFilter && (
        <FilterBuilder
          columns={ALL_COLUMNS}
          data={rowData}
          onApplyFilter={handleAdvancedFilterApply}
          onClose={() => setShowAdvancedFilter(false)}
        />
      )}

      {/* Column Manager Sidebar */}
      {showColumnManager && (
        <div className="column-manager">
          <div className="manager-header">
            <h3>Column Manager</h3>
            <button onClick={() => setShowColumnManager(false)} className="btn-close">&times;</button>
          </div>
          <div className="manager-actions">
            <button onClick={showAllColumns} className="btn-sm">Show All</button>
            <button onClick={showEssentialOnly} className="btn-sm">Essential Only</button>
          </div>
          <div className="column-list">
            {ALL_COLUMNS.map(col => (
              <label key={col.field} className="column-item">
                <input
                  type="checkbox"
                  checked={!hiddenColumns.includes(col.field)}
                  onChange={() => toggleColumn(col.field)}
                />
                <span className={col.editable === false ? 'readonly' : ''}>{col.headerName}</span>
                <button
                  className={`freeze-btn ${pinnedColumns.includes(col.field) ? 'active' : ''}`}
                  onClick={(e) => {
                    e.preventDefault()
                    e.stopPropagation()
                    toggleFreeze(col.field)
                  }}
                  title={pinnedColumns.includes(col.field) ? 'Unfreeze Column' : 'Freeze Column'}
                >
                  {pinnedColumns.includes(col.field) ? '* Frozen' : 'Freeze'}
                </button>
              </label>
            ))}
          </div>
        </div>
      )}

      {/* Grid */}
      <div className="ag-theme-alpine spreadsheet-grid">
        <AgGridReact
          ref={gridRef}
          rowData={searchQuery ? filteredData : rowData}
          columnDefs={columnDefs}
          defaultColDef={defaultColDef}
          quickFilterText={quickFilter}
          onCellValueChanged={onCellValueChanged}
          onCellClicked={onCellClicked}
          onRowDoubleClicked={onRowDoubleClicked}
          rowSelection="multiple"
          onSelectionChanged={onSelectionChanged}
          enableCellTextSelection={true}
          ensureDomOrder={true}
          animateRows={true}
          pagination={true}
          paginationPageSize={density === 'dense' ? 200 : density === 'compact' ? 150 : 100}
          paginationPageSizeSelector={[50, 100, 150, 200, 500]}
          domLayout="normal"
          rowHeight={currentDensity.rowHeight}
          headerHeight={currentDensity.headerHeight}
        />
      </div>

      {/* Keyboard shortcuts help */}
      <div className="keyboard-shortcuts">
        <span>⌨️ Shortcuts:</span>
        <kbd>Ctrl+C</kbd> Copy
        <kbd>Ctrl+V</kbd> Paste
        <kbd>Enter</kbd> Edit
        <kbd>Ctrl+Click</kbd> History
        <kbd>Double-Click</kbd> Comments
        {isFullscreen && <><kbd>ESC</kbd> Exit</>}
        <span className="separator">|</span>
        <span>Density: ⊞ Comfortable | ⊟ Compact | ≡ Dense</span>
        {selectedRows.length > 0 && (
          <span className="selection-info">| {selectedRows.length} rows selected</span>
        )}
        {onlineUsers.filter(u => u.status === 'online').length > 0 && (
          <span className="online-info">| 👥 {onlineUsers.filter(u => u.status === 'online').length} متصل</span>
        )}
      </div>
    </div>
  )

  // Return with or without MainLayout based on fullscreen state
  if (isFullscreen) {
    return spreadsheetContent
  }

  return <MainLayout>{spreadsheetContent}</MainLayout>
}

export default SpreadsheetView
