# Server-side Environment Variables
# WARNING: Keep this file SECRET! Never commit to version control.
# This file contains sensitive credentials for server-side operations only.
#
# Copy this file to .env.server and fill in your actual values:
#   cp electron/.env.server.example electron/.env.server

# ============================================
# Supabase Service Role Key
# ============================================
# This key bypasses Row Level Security and should ONLY be used server-side
# Find it in: Supabase Dashboard > Settings > API > Project API keys > service_role
# NEVER expose this key in client-side code!

SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# ============================================
# Server Authentication
# ============================================
# Secret key for server-to-server authentication
JWT_SERVER_SECRET=generate-a-strong-random-secret-minimum-32-chars
